# GitHub PAT — reading PRs + posting slice/PR reviews (Approve buttons)
# Fine-grained: repo access + Pull requests (Read and write) + Contents (Read)
# Classic: scope "repo" (private) or "public_repo" (public only)
# Org repos: authorize SSO on the token in GitHub Settings
GITHUB_TOKEN=ghp_...

# Cursor — breakouts + architecture diagram visual (Dashboard → Integrations)
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=crsr_...
CURSOR_MODEL=composer-2.5

# Default AI: Cursor when CURSOR_API_KEY is set (remove OPENROUTER_API_KEY to avoid 401s)
# CEDAR_AI_PROVIDER=cursor

# Reaper-style Cursor bridge (session + plan mode, default on)
# CEDAR_CURSOR_BRIDGE=false
# CEDAR_CURSOR_BRIDGE_PORT=8092
# plan | ask | agent — plan = JSON/review only, no file edits (default)
# CEDAR_CURSOR_MODE=plan

# Optional legacy (only if CURSOR_API_KEY unset)
# OPENROUTER_API_KEY=sk-or-v1-...

# auto | ai | yaml — auto enables AI when CURSOR_API_KEY is set
CEDAR_PARTITION_MODE=auto

# auto (breakouts+d diagram in one call) | split (2nd call) | false (heuristic layout only)
# CEDAR_AI_DIAGRAM=auto
# Cache AI breakouts per owner/repo/pr/headSha (set false to bust)
# CEDAR_BREAKOUT_CACHE=true

# Automated per-slice code review (off — human review in UI)
# CEDAR_AI_SLICE_REVIEW=true

PORT=3847

# Diff viewer default font: xs (8px) | sm | md | lg | xl, or pixel size 8–16 (UI overrides via localStorage)
# CEDAR_DIFF_FONT_SIZE=8